# Required server-only host credential: generate 32 random bytes, never commit values.
HOST_SECRET=
# Required credential for the independent worker / external scheduled request.
SCHEDULER_SECRET=
# Canonical application origin, HTTPS in production. CSRF requests must match exactly.
APP_ORIGIN=http://localhost:3000
# Optional production PostgreSQL connection string. Use a trusted CA; do not disable TLS verification.
DATABASE_URL=
# Local durable SQLite database. Single persistent server only, never serverless ephemeral storage.
SQLITE_PATH=.data/control.sqlite
# Only for explicit localhost HTTP testing. Leave unset on a real HTTPS deployment.
ALLOW_INSECURE_LOCAL=1

# Optional internal scheduler destination for managed startup; normally set by the supervisor.
SCHEDULER_ORIGIN=
# The managed production process reads PORT (default 3000; Render injects it).
PORT=3000
